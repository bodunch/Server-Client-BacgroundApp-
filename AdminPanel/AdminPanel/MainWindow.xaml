<Window x:Class="AdminPanel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AdminPanel"
        xmlns:vm="clr-namespace:AdminPanel.ViewModel"
        mc:Ignorable="d"
        Title="MainWindow"
        Width="1920"
        Height="1080"
        WindowState="Maximized">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="318*" />
            <ColumnDefinition Width="19.876" />
            <ColumnDefinition Width="398*" />
            <ColumnDefinition Width="398*" />
            <ColumnDefinition Width="12*" />
            <ColumnDefinition Width="755*" />
            <ColumnDefinition Width="20*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="20*" />
            <RowDefinition Height="63*" />
            <RowDefinition Height="37*" />
            <RowDefinition Height="100*" />
            <RowDefinition Height="100*" />
            <RowDefinition Height="100*" />
            <RowDefinition Height="12*" />
            <RowDefinition Height="55*" />
            <RowDefinition Height="55*" />
            <RowDefinition Height="55*" />
            <RowDefinition Height="55*" />
            <RowDefinition Height="55*" />
            <RowDefinition Height="55*" />
            <RowDefinition Height="55*" />
            <RowDefinition Height="207*" />
            <RowDefinition Height="17*" />
        </Grid.RowDefinitions>

        <Label Grid.Row="1"
               Content="Networked PCs:"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               FontSize="20"
               FontWeight="Bold"
               Height="37"
               Width="160" />

        <ScrollViewer Grid.Row="2"
                      Grid.RowSpan="15"
                      Grid.Column="0"
                      VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding ClientsItem}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Vertical" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Content="{Binding MachineName}"
                                Tag="{Binding Id}"
                                Click="OpenClientInfo"
                                Margin="0,3,0,3"
                                Padding="10,5" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <TextBlock Grid.Column="2"
                   Grid.ColumnSpan="2"
                   Grid.Row="1"
                   Grid.RowSpan="2"
                   x:Name="TextBox_Copy"
                   TextWrapping="Wrap"
                   Text="{Binding staticInfoTextBox.SystemInfoText}"
                   FontFamily="Arial" />
        <TextBlock Grid.Column="2"
                   Grid.ColumnSpan="2"
                   Grid.Row="3"
                   x:Name="TextBox_Copy1"
                   TextWrapping="Wrap"
                   Text="{Binding staticInfoTextBox.ComputerInfoText}" />
        <TextBlock Grid.Column="2"
                   Grid.ColumnSpan="2"
                   Grid.Row="4"
                   x:Name="TextBox"
                   TextWrapping="Wrap"
                   Text="{Binding staticInfoTextBox.CpuInfoText}" />
        <TextBlock Grid.Column="2"
                   Grid.ColumnSpan="2"
                   Grid.Row="5"
                   x:Name="TextBox_Copy2"
                   TextWrapping="Wrap"
                   Text="{Binding staticInfoTextBox.RamInfoText}" />

        <UniformGrid Grid.Column="2"
                     Grid.Row="7"
                     Grid.RowSpan="7"
                     Rows="7"
                     x:Name="DynamicButtonsPanel"
                     Visibility="Collapsed">
            <Button Grid.Row="7"
                    Grid.Column="2"
                    Tag="CpuInfo"
                    Content="CPU info"
                    Click="OpenDynamicClientInfo" />
            <Button Grid.Row="8"
                    Grid.Column="2"
                    Tag="RamInfo"
                    Content="RAM info"
                    Click="OpenDynamicClientInfo" />
            <Button Grid.Row="9"
                    Grid.Column="2"
                    Tag="ProcessInfo"
                    Content="Processes info"
                    Click="OpenDynamicClientInfo" />
            <Button Grid.Row="10"
                    Grid.Column="2"
                    Tag="PortsInfo"
                    Content="Ports info"
                    Click="OpenDynamicClientInfo" />
            <Button Grid.Row="11"
                    Grid.Column="2"
                    Tag="ConnectionsInfo"
                    Content="Connections info"
                    Click="OpenDynamicClientInfo" />
            <Button Grid.Row="12"
                    Grid.Column="2"
                    Tag="ApplicationsInfo"
                    Content="Applications info"
                    Click="OpenDynamicClientInfo" />
            <Button Grid.Row="13"
                    Grid.Column="2"
                    Tag="AdaptersInfo"
                    Content="Adapters info"
                    Click="OpenDynamicClientInfo" />
        </UniformGrid>

        <ScrollViewer Grid.Row="14"
                      Grid.Column="2"
                      Grid.ColumnSpan="4"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto">

            <TextBox x:Name="dynamicInfoTextBox"
                     Text="{Binding staticInfoTextBox.DnmInfoText}" />
        </ScrollViewer>
    </Grid>
</Window>