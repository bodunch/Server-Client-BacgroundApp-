<Window x:Class="AdminPanel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AdminPanel"
        xmlns:vm="clr-namespace:AdminPanel.ViewModel"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        mc:Ignorable="d"
        Title="MainWindow"
        Width="1920"
        Height="1080"
        WindowState="Maximized">
    
    <Window.Resources>
        <Style x:Key="CustomHoverButton"
               TargetType="Button">

            <Setter Property="Background"
                    Value="White" />
            <Setter Property="BorderThickness"
                    Value="1.2" />
            <Setter Property="BorderBrush"
                    Value="#333333" />
            <Setter Property="Cursor"
                    Value="Hand" />

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="border"
                                        Property="Background"
                                        Value="#333333" />
                                <Setter Property="Foreground"
                                        Value="White" />
                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">
                                <Setter TargetName="border"
                                        Property="Background"
                                        Value="#333333" />
                                <Setter Property="Foreground"
                                        Value="White" />
                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">
                                <Setter TargetName="border"
                                        Property="Background"
                                        Value="White" />
                                <Setter Property="Foreground"
                                        Value="Black" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>


    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid Background="#CCD9D9">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="2.5*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*" />
            <RowDefinition Height="3*" />
            <RowDefinition Height="6*" />
            <RowDefinition Height="2*" />
        </Grid.RowDefinitions>
        
        

        <Label Grid.Column="0"
               Grid.Row="0"
               Grid.ColumnSpan="2"
               Content="LAN Monitoring System"
               FontSize="30"
               FontWeight="Bold"
               FontFamily="Consolas"
               Margin="20, 0, 0, 0"
               VerticalAlignment="Center" />

        <Button Grid.Column="2"
                Grid.Row="0"
                Background="#CCD9D9"
                BorderBrush="#CCD9D9"
                Cursor="Hand"
                Margin="740,10,30,10">
            <Image Source="/Images/settings.png"
                   Width="50"
                   Height="50" />
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <!-- Left clients -->
        <Border Grid.Column="0"
                Grid.Row="1"
                Grid.RowSpan="3"
                Background="White"
                BorderBrush="#333333"
                BorderThickness="1.5"
                CornerRadius="12"
                Padding="10"
                Margin="10,0,5,10">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*" />
                    <RowDefinition Height="1.3*" />
                    <RowDefinition Height="20*" />
                </Grid.RowDefinitions>

                <Label Grid.Column="0"
                       Grid.Row="0"
                       Grid.ColumnSpan="2"
                       Content="Connected users"
                       FontSize="20"
                       FontFamily="Consolas"/>

                <Button Grid.Column="1"
                        Grid.Row="0"
                        Background="White"
                        BorderBrush="White"
                        Cursor="Hand"
                        Margin="97,0,5,5">
                    <Image Source="/Images/update.png"
                           Width="30"
                           Height="30" />
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Border Grid.Column="0"
                        Grid.Row="1"
                        Grid.ColumnSpan="2"
                        Background="White"
                        BorderBrush="#333333"
                        BorderThickness="1.5"
                        CornerRadius="12"
                        Padding="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="4*" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 BorderBrush="#333333"
                                 FontFamily="Consolas"
                                 FontSize="16">
                            <TextBox.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius"
                                            Value="16" />
                                </Style>
                            </TextBox.Resources>
                        </TextBox>

                        <Button Grid.Column="1"
                                Background="White"
                                BorderBrush="White"
                                Cursor="Hand">
                            <Image Source="/Images/search.png"
                                   Width="30"
                                   Height="30" />
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="2"
                              Grid.Column="0"
                              Grid.ColumnSpan="2"
                              VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding ClientsItem}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Vertical" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding MachineName}"
                                        Tag="{Binding Id}"
                                        Click="OpenClientInfo"
                                        Margin="0,3,0,3"
                                        Padding="10,5"
                                        Style="{StaticResource CustomHoverButton}"
                                        FontFamily="Consolas">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius"
                                                    Value="12" />
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Lower commands -->
        <Border Grid.Column="1"
                Grid.Row="3"
                Grid.ColumnSpan="2"
                Background="White"
                BorderBrush="#333333"
                BorderThickness="1.5"
                CornerRadius="12"
                Padding="10"
                Margin="5,5,10,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*" />
                    <RowDefinition Height="2*" />
                </Grid.RowDefinitions>

                <Label Grid.Column="0"
                       Grid.Row="0"
                       Content="Commands"
                       FontSize="20"
                       FontFamily="Consolas" 
                       VerticalAlignment="Top"/>

                <Border Grid.Column="1"
                        Grid.Row="0"
                        Grid.ColumnSpan="2"
                        Background="White"
                        BorderBrush="#333333"
                        BorderThickness="1.5"
                        CornerRadius="12"
                        Padding="7">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
 
                        <Button Grid.Column="0"
                                Style="{StaticResource CustomHoverButton}"
                                Tag="BtnPowerOff"
                                Content="Turn off PC"
                                Click="SendStandartCommand"
                                Margin="0, 0, 2.5, 0"
                                FontFamily="Consolas">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius"
                                            Value="12" />
                                </Style>
                            </Button.Resources>
                        </Button>

                        <Button Grid.Column="1"
                                Tag="BtnReboot"
                                Content="Reboot PC"
                                Click="SendStandartCommand"
                                Margin="2.5, 0, 2.5, 0"
                                Style="{StaticResource CustomHoverButton}"
                                FontFamily="Consolas">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius"
                                            Value="12" />
                                </Style>
                            </Button.Resources>
                        </Button>

                        <Button Grid.Column="2"
                                Tag="BtnNetwork"
                                Content="Turn off network"
                                Click="SendStandartCommand"
                                Margin="2.5, 0, 2.5, 0"
                                Style="{StaticResource CustomHoverButton}"
                                FontFamily="Consolas">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius"
                                            Value="12" />
                                </Style>
                            </Button.Resources>
                        </Button>

                        <Button Grid.Column="3"
                                Tag="BtnNetwork"
                                Content="Turn off network"
                                Margin="2.5, 0, 0, 0"
                                Style="{StaticResource CustomHoverButton}"
                                FontFamily="Consolas">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius"
                                            Value="12" />
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>
                </Border>

                <Border Grid.Column="0"
                        Grid.Row="1"
                        Grid.ColumnSpan="3"
                        Background="White"
                        BorderBrush="#333333"
                        BorderThickness="1.5"
                        CornerRadius="12"
                        Padding="10"
                        Margin="0,10,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="15*" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="1*" />
                            <RowDefinition Height="1*" />
                        </Grid.RowDefinitions>

                        <TextBox Grid.Column="0"
                                 Grid.Row="0"
                                 Grid.RowSpan="2"
                                 x:Name="TxtCustomCommand"
                                 BorderBrush="#333333"
                                 FontFamily="Consolas"
                                 FontSize="20"
                                 TextAlignment="Center"
                                 VerticalContentAlignment="Center">
                            <TextBox.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius"
                                            Value="12" />
                                </Style>
                            </TextBox.Resources>
                        </TextBox>

                        <Button Grid.Column="1"
                                Grid.Row="0"
                                Grid.RowSpan="2"
                                Tag="BtnSendCustom"
                                Content="Send"
                                Click="SendAdminCommand"
                                Margin="5, 0, 2.5, 0"
                                Style="{StaticResource CustomHoverButton}"
                                FontFamily="Consolas">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius"
                                            Value="12" />
                                </Style>
                            </Button.Resources>
                        </Button>

                        <Button Grid.Column="2"
                                Grid.Row="0"
                                Content="History"
                                Margin="2.5, 0, 0, 2.5"
                                Style="{StaticResource CustomHoverButton}"
                                FontFamily="Consolas">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius"
                                            Value="12" />
                                </Style>
                            </Button.Resources>
                        </Button>

                        <Button Grid.Column="2"
                                Grid.Row="1"
                                Content="Clear"
                                Margin="2.5, 2.5, 0, 0"
                                Style="{StaticResource CustomHoverButton}"
                                FontFamily="Consolas">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius"
                                            Value="12" />
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Right logs -->
        <Border Grid.Column="2"
                Grid.Row="1"
                Grid.RowSpan="2"
                Background="White"
                BorderBrush="#333333"
                BorderThickness="1.5"
                CornerRadius="12"
                Padding="10"
                Margin="5,0,10,5">
            
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*" />
                    <RowDefinition Height="1.2*" />
                    <RowDefinition Height="6*" />
                    <RowDefinition Height="6*" />
                </Grid.RowDefinitions>

                <Label Grid.Column="0"
                       Grid.Row="0"
                       Content="Logs"
                       HorizontalAlignment="Left"
                       FontSize="20"
                       FontFamily="Consolas" />

                <Button Grid.Column="6"
                        Grid.Row="0"
                        Margin="0, 0, 0, 2.5"
                        Style="{StaticResource CustomHoverButton}"
                        FontFamily="Consolas">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius"
                                    Value="18" />
                        </Style>
                    </Button.Resources>
                </Button>

                <UniformGrid Grid.Column="0"
                             Grid.Row="1"
                             Grid.ColumnSpan="7"
                             Columns="7"
                             x:Name="DynamicButtonsPanel"
                             Visibility="Visible">
                    
                    <Button Grid.Row="0"
                            Grid.Column="0"
                            Tag="CpuInfo"
                            Content="CPU"
                            Click="OpenDynamicClientInfo"
                            Margin="0, 2.5, 2.5, 5"
                            Style="{StaticResource CustomHoverButton}"
                            FontFamily="Consolas">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius"
                                        Value="18" />
                            </Style>
                        </Button.Resources>
                    </Button>
                    
                    <Button Grid.Row="0"
                            Grid.Column="1"
                            Tag="RamInfo"
                            Content="RAM"
                            Click="OpenDynamicClientInfo"
                            Margin="2.5, 2.5, 2.5, 5"
                            Style="{StaticResource CustomHoverButton}"
                            FontFamily="Consolas">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius"
                                        Value="18" />
                            </Style>
                        </Button.Resources>
                    </Button>

                    <Button Grid.Row="0"
                            Grid.Column="2"
                            Tag="ProcessInfo"
                            Content="Processes"
                            Click="OpenDynamicClientInfo"
                            Margin="2.5, 2.5, 2.5, 5"
                            Style="{StaticResource CustomHoverButton}"
                            FontFamily="Consolas">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius"
                                        Value="18" />
                            </Style>
                        </Button.Resources>
                    </Button>

                    <Button Grid.Row="0"
                            Grid.Column="3"
                            Tag="PortsInfo"
                            Content="Ports"
                            Click="OpenDynamicClientInfo"
                            Margin="2.5, 2.5, 2.5, 5"
                            Style="{StaticResource CustomHoverButton}"
                            FontFamily="Consolas">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius"
                                        Value="18" />
                            </Style>
                        </Button.Resources>
                    </Button>

                    <Button Grid.Row="0"
                            Grid.Column="4"
                            Tag="ConnectionsInfo"
                            Content="Connections"
                            Click="OpenDynamicClientInfo"
                            Margin="2.5, 2.5, 2.5, 5"
                            Style="{StaticResource CustomHoverButton}"
                            FontFamily="Consolas">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius"
                                        Value="18" />
                            </Style>
                        </Button.Resources>
                    </Button>

                    <Button Grid.Row="0"
                            Grid.Column="5"
                            Tag="ApplicationsInfo"
                            Content="Applications"
                            Click="OpenDynamicClientInfo"
                            Margin="2.5, 2.5, 2.5, 5"
                            Style="{StaticResource CustomHoverButton}"
                            FontFamily="Consolas">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius"
                                        Value="18" />
                            </Style>
                        </Button.Resources>
                    </Button>

                    <Button Grid.Row="0"
                            Grid.Column="6"
                            Tag="AdaptersInfo"
                            Content="Adapters"
                            Click="OpenDynamicClientInfo"
                            Margin="2.5, 2.5, 0, 5"
                            Style="{StaticResource CustomHoverButton}"
                            FontFamily="Consolas">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius"
                                        Value="18" />
                            </Style>
                        </Button.Resources>
                    </Button>
                </UniformGrid>

                <Border Grid.Column="0"
                        Grid.Row="2"
                        Grid.ColumnSpan="7"
                        Background="White"
                        BorderBrush="#333333"
                        BorderThickness="1.5"
                        CornerRadius="12"
                        Padding="10"
                        Margin="0,0,0,5">
                    <lvc:CartesianChart x:Name="cartesianChart" />
                </Border>

                <Border Grid.Column="0"
                        Grid.Row="3"
                        Grid.ColumnSpan="7"
                        Background="White"
                        BorderBrush="#333333"
                        BorderThickness="1.5"
                        CornerRadius="12"
                        Padding="10"
                        Margin="0,5,0,0">
                    <RichTextBox x:Name="dynamicInfoTextBox"
                                 IsReadOnly="True"
                                 FontFamily="Consolas"
                                 Background="White"
                                 BorderBrush="White"
                                 HorizontalAlignment="Stretch"
                                 VerticalAlignment="Stretch"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Disabled">
                        <RichTextBox.Resources>
                            <Style TargetType="{x:Type Paragraph}">
                                <Setter Property="Margin"
                                        Value="0" />
                            </Style>
                        </RichTextBox.Resources>
                    </RichTextBox>
                </Border>

                
            </Grid>
        </Border>

        <!-- Center-upper static info -->
        <Border Grid.Column="1"
                Grid.Row="1"
                Background="White"
                BorderBrush="#333333"
                BorderThickness="1.5"
                CornerRadius="12"
                Padding="10"
                Margin="5, 0, 5, 5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="1.2*" />
                    <RowDefinition Height="8*" />
                </Grid.RowDefinitions>

                <Label Grid.Row="0"
                       Content="Static info"
                       FontSize="20"
                       FontFamily="Consolas" />

                <Border Grid.Row="1"
                        Background="White"
                        BorderBrush="#333333"
                        BorderThickness="1.5"
                        CornerRadius="12"
                        Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="1*" />
                            <RowDefinition Height="1*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Grid.Row="0"
                                   x:Name="TextBox_Copy"
                                   TextWrapping="Wrap"
                                   Text="{Binding staticInfoTextBox.SystemInfoText}"
                                   FontFamily="Consolas" />
                        <TextBlock Grid.Column="0"
                                   Grid.Row="1"
                                   x:Name="TextBox_Copy1"
                                   TextWrapping="Wrap"
                                   Text="{Binding staticInfoTextBox.ComputerInfoText}"
                                   FontFamily="Consolas" />
                        <TextBlock Grid.Column="1"
                                   Grid.Row="0"
                                   x:Name="TextBox"
                                   TextWrapping="Wrap"
                                   Text="{Binding staticInfoTextBox.CpuInfoText}"
                                   FontFamily="Consolas" />
                        <TextBlock Grid.Column="1"
                                   Grid.Row="1"
                                   x:Name="TextBox_Copy2"
                                   TextWrapping="Wrap"
                                   Text="{Binding staticInfoTextBox.RamInfoText}"
                                   FontFamily="Consolas" />
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Center monitoring -->
        <Border Grid.Column="1"
                Grid.Row="2"
                Background="White"
                BorderBrush="#333333"
                BorderThickness="1.5"
                CornerRadius="12"
                Padding="10"
                Margin="5, 5, 5, 5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*" />
                    <RowDefinition Height="9*" />
                </Grid.RowDefinitions>

                <Label Grid.Column="0"
                       Grid.Row="0"
                       Content="Monitoring"
                       FontSize="20"
                       FontFamily="Consolas" />

                <Button Grid.Column="1"
                        Grid.Row="0"
                        Content="Start"
                        Click="BtnStartStream_Click"
                        Margin="0, 0, 2.5, 10"
                        Style="{StaticResource CustomHoverButton}"
                        FontFamily="Consolas">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius"
                                    Value="12" />
                        </Style>
                    </Button.Resources>
                </Button>

                <Button Grid.Column="2"
                        Grid.Row="0"
                        Content="Pause"
                        Click="BtnPauseStream_Click"
                        Margin="2.5, 0, 0, 10"
                        Style="{StaticResource CustomHoverButton}"
                        FontFamily="Consolas">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius"
                                    Value="12" />
                        </Style>
                    </Button.Resources>
                </Button>

                <Border Grid.Column="0"
                        Grid.ColumnSpan="3"
                        Grid.Row="1"
                        Background="White"
                        BorderBrush="#333333"
                        BorderThickness="1.5"
                        CornerRadius="12"
                        Padding="10">

                    <Image x:Name="ClientScreenImage"
                           Stretch="Uniform"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>