<Window x:Class="AdminPanel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AdminPanel"
        xmlns:vm="clr-namespace:AdminPanel.ViewModel"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        mc:Ignorable="d"
        Title="MainWindow"
        Width="1920"
        Height="1080"
        WindowState="Maximized">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="2.5*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*" />
            <RowDefinition Height="3*" />
            <RowDefinition Height="6*" />
            <RowDefinition Height="2*" />
        </Grid.RowDefinitions>

        <Label Grid.Column="0"
               Grid.Row="0"
               Content="APP Name"/>

        <Button Grid.Column="2"
                Grid.Row="0" />

        <!-- Left clients -->
        <Border Grid.Column="0"
                Grid.Row="1"
                Grid.RowSpan="3"
                Background="White"
                BorderBrush="#333333"
                BorderThickness="1.5"
                CornerRadius="12"
                Padding="10">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*" />
                    <RowDefinition Height="2*" />
                    <RowDefinition Height="20*" />
                </Grid.RowDefinitions>

                <Label Grid.Column="0"
                       Grid.Row="0"
                       Content="Clients" />

                <Button Grid.Column="1"
                        Grid.Row="0"
                        Content="Update" />

                <Border Grid.Column="0"
                        Grid.Row="1"
                        Grid.ColumnSpan="2"
                        Background="White"
                        BorderBrush="#333333"
                        BorderThickness="1.5"
                        CornerRadius="12"
                        Padding="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0" />

                        <Button Grid.Column="1" />
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="2"
                              Grid.Column="0"
                              Grid.ColumnSpan="2"
                              VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding ClientsItem}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Vertical" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding MachineName}"
                                        Tag="{Binding Id}"
                                        Click="OpenClientInfo"
                                        Margin="0,3,0,3"
                                        Padding="10,5" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Lower commands -->
        <Border Grid.Column="1"
                Grid.Row="3"
                Grid.ColumnSpan="2"
                Background="White"
                BorderBrush="#333333"
                BorderThickness="1.5"
                CornerRadius="12"
                Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*" />
                    <RowDefinition Height="1*" />
                </Grid.RowDefinitions>

                <Label Grid.Column="0"
                       Grid.Row="0"
                       Content="Commands"/>

                <Border Grid.Column="1"
                        Grid.Row="0"
                        Grid.ColumnSpan="2"
                        Background="White"
                        BorderBrush="#333333"
                        BorderThickness="1.5"
                        CornerRadius="12"
                        Padding="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Tag="BtnPowerOff"
                                Content="Turn off PC"
                                Click="SendStandartCommand" />

                        <Button Grid.Column="1"
                                Tag="BtnReboot"
                                Content="Reboot PC"
                                Click="SendStandartCommand" />

                        <Button Grid.Column="2"
                                Tag="BtnNetwork"
                                Content="Turn off network"
                                Click="SendStandartCommand" />

                        <Button Grid.Column="3"
                                Tag="BtnNetwork"
                                Content="Turn off network" />
                    </Grid>
                </Border>

                <TextBox Grid.Column="0"
                         Grid.Row="1"
                         Grid.ColumnSpan="2"
                         x:Name="TxtCustomCommand" />

                <Border Grid.Column="2"
                        Grid.Row="1"
                        Grid.ColumnSpan="2"
                        Background="White"
                        BorderBrush="#333333"
                        BorderThickness="1.5"
                        CornerRadius="12"
                        Padding="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="1*" />
                            <RowDefinition Height="1*" />
                        </Grid.RowDefinitions>
                        
                        <Button Grid.Column="0"
                                Grid.Row="0"
                                Grid.RowSpan="2"
                                Tag="BtnSendCustom"
                                Content="Send"
                                Click="SendAdminCommand" />

                        <Button Grid.Column="1"
                                Grid.Row="0"
                                Content="History" />

                        <Button Grid.Column="1"
                                Grid.Row="1"
                                Content="Clear" />
                    </Grid>
                </Border>

                

            </Grid>
        </Border>

        <!-- Right logs -->
        <Border Grid.Column="2"
                Grid.Row="1"
                Grid.RowSpan="2"
                Background="White"
                BorderBrush="#333333"
                BorderThickness="1.5"
                CornerRadius="12"
                Padding="10">
            
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*" />
                    <RowDefinition Height="1.2*" />
                    <RowDefinition Height="6*" />
                    <RowDefinition Height="6*" />
                </Grid.RowDefinitions>

                <Label Grid.Column="0"
                       Grid.Row="0"
                       Content="Logs"
                       HorizontalAlignment="Left"/>

                <Button Grid.Column="6"
                        Grid.Row="0" />

                <UniformGrid Grid.Column="0"
                             Grid.Row="1"
                             Grid.ColumnSpan="7"
                             Columns="7"
                             x:Name="DynamicButtonsPanel"
                             Visibility="Collapsed">
                    <Button Grid.Row="0"
                            Grid.Column="0"
                            Tag="CpuInfo"
                            Content="CPU info"
                            Click="OpenDynamicClientInfo" />
                    <Button Grid.Row="0"
                            Grid.Column="1"
                            Tag="RamInfo"
                            Content="RAM info"
                            Click="OpenDynamicClientInfo" />
                    <Button Grid.Row="0"
                            Grid.Column="2"
                            Tag="ProcessInfo"
                            Content="Processes info"
                            Click="OpenDynamicClientInfo" />
                    <Button Grid.Row="0"
                            Grid.Column="3"
                            Tag="PortsInfo"
                            Content="Ports info"
                            Click="OpenDynamicClientInfo" />
                    <Button Grid.Row="0"
                            Grid.Column="4"
                            Tag="ConnectionsInfo"
                            Content="Connections info"
                            Click="OpenDynamicClientInfo" />
                    <Button Grid.Row="0"
                            Grid.Column="5"
                            Tag="ApplicationsInfo"
                            Content="Applications info"
                            Click="OpenDynamicClientInfo" />
                    <Button Grid.Row="0"
                            Grid.Column="6"
                            Tag="AdaptersInfo"
                            Content="Adapters info"
                            Click="OpenDynamicClientInfo" />
                </UniformGrid>

                <Border Grid.Column="0"
                        Grid.Row="2"
                        Grid.ColumnSpan="7"
                        Background="White"
                        BorderBrush="#333333"
                        BorderThickness="1.5"
                        CornerRadius="12"
                        Padding="10">
                    <lvc:CartesianChart x:Name="cartesianChart" />
                </Border>

                <Border Grid.Column="0"
                        Grid.Row="3"
                        Grid.ColumnSpan="7"
                        Background="White"
                        BorderBrush="#333333"
                        BorderThickness="1.5"
                        CornerRadius="12"
                        Padding="10">
                    <RichTextBox x:Name="dynamicInfoTextBox"
                                 IsReadOnly="True"
                                 Background="White"
                                 BorderBrush="White"
                                 HorizontalAlignment="Stretch"
                                 VerticalAlignment="Stretch"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Disabled">
                        <RichTextBox.Resources>
                            <Style TargetType="{x:Type Paragraph}">
                                <Setter Property="Margin"
                                        Value="0" />
                            </Style>
                        </RichTextBox.Resources>
                    </RichTextBox>
                </Border>

                
            </Grid>
        </Border>

        <!-- Center-upper static info -->
        <Border Grid.Column="1"
                Grid.Row="1"
                Background="White"
                BorderBrush="#333333"
                BorderThickness="1.5"
                CornerRadius="12"
                Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*" />
                    <RowDefinition Height="8*" />
                </Grid.RowDefinitions>

                <Label Grid.Row="0"
                       Content="Static info"/>

                <Border Grid.Row="1"
                        Background="White"
                        BorderBrush="#333333"
                        BorderThickness="1.5"
                        CornerRadius="12"
                        Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="1*" />
                            <RowDefinition Height="1*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Grid.Row="0"
                                   x:Name="TextBox_Copy"
                                   TextWrapping="Wrap"
                                   Text="{Binding staticInfoTextBox.SystemInfoText}"
                                   FontFamily="Arial" />
                        <TextBlock Grid.Column="0"
                                   Grid.Row="1"
                                   x:Name="TextBox_Copy1"
                                   TextWrapping="Wrap"
                                   Text="{Binding staticInfoTextBox.ComputerInfoText}" />
                        <TextBlock Grid.Column="1"
                                   Grid.Row="0"
                                   x:Name="TextBox"
                                   TextWrapping="Wrap"
                                   Text="{Binding staticInfoTextBox.CpuInfoText}" />
                        <TextBlock Grid.Column="1"
                                   Grid.Row="1"
                                   x:Name="TextBox_Copy2"
                                   TextWrapping="Wrap"
                                   Text="{Binding staticInfoTextBox.RamInfoText}" />
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Center monitoring -->
        <Border Grid.Column="1"
                Grid.Row="2"
                Background="White"
                BorderBrush="#333333"
                BorderThickness="1.5"
                CornerRadius="12"
                Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*" />
                    <RowDefinition Height="9*" />
                </Grid.RowDefinitions>

                <Label Grid.Column="0"
                       Grid.Row="0"
                       Content="Monitoring"/>

                <Button Grid.Column="1"
                        Grid.Row="0"
                        Content="Start"/>

                <Button Grid.Column="2"
                        Grid.Row="0"
                        Content="Pause"/>

                <Border Grid.Column="0"
                        Grid.ColumnSpan="3"
                        Grid.Row="1"
                        Background="White"
                        BorderBrush="#333333"
                        BorderThickness="1.5"
                        CornerRadius="12"
                        Padding="10">
                    <Image />
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>